---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type Frame = { src: ImageMetadata; alt: string; caption: string; href?: string };
interface Props { frames: Frame[]; label: string; class?: string }
const { frames, label, class: cls = '' } = Astro.props;
---

<div class:list={['strip', cls]} role="region" aria-label={label} tabindex="0" data-strip>
  <ul class="strip__row">
    {frames.map((f, i) => (
      <li class="strip__frame" data-strip-frame>
        <figure>
          <div class="strip__pic">
            <Image src={f.src} alt={f.alt} widths={[480, 800, 1200]} sizes="(max-width: 700px) 80vw, 40vw" loading={i < 4 ? 'eager' : 'lazy'} class="strip__img" />
          </div>
          <figcaption class="strip__cap">{f.caption}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
</div>

<style>
  .strip {
    overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none;
    cursor: grab; outline-offset: -2px;
  }
  .strip::-webkit-scrollbar { display: none; }
  .strip.is-dragging { cursor: grabbing; scroll-snap-type: none; }
  .strip.is-dragging * { pointer-events: none; }
  .strip__row { display: flex; gap: 10px; width: max-content; padding-inline: var(--margin); }
  .strip__frame { scroll-snap-align: center; flex: none; }
  .strip__row { gap: 14px; }
  .strip__pic { height: var(--strip-h, 46vh); min-height: 260px; overflow: clip; border-radius: var(--r-tile); box-shadow: var(--shadow); }
  .strip__img {
    height: 100%; width: auto; max-width: none; object-fit: cover;
    filter: brightness(0.6) saturate(0.85);
    transition: filter 600ms var(--ease-out), transform 900ms var(--ease-expo);
  }
  .strip__frame.is-center .strip__img { filter: none; }
  .strip__cap {
    margin-top: 0.9rem; font-size: var(--step-small); font-weight: 500; color: var(--muted);
    opacity: 0; transform: translateY(6px); transition: opacity 400ms ease, transform 500ms var(--ease-out);
  }
  .strip__frame.is-center .strip__cap { opacity: 1; transform: none; color: var(--ink); }
  @media (hover: hover) and (pointer: fine) {
    .strip__frame:hover .strip__img { filter: brightness(0.9) contrast(1.05); }
    .strip__frame:hover .strip__cap { opacity: 1; transform: none; }
  }
  @media (max-width: 700px) {
    .strip__pic { height: var(--strip-h-phone, 46vh); }
    .strip__img { width: 80vw; }
  }
  html:not(.js) .strip__img { filter: brightness(0.9); }
  html:not(.js) .strip__cap { opacity: 1; transform: none; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-strip]').forEach((strip) => {
    const frames = [...strip.querySelectorAll<HTMLElement>('[data-strip-frame]')];
    let raf = 0;
    const mark = () => {
      raf = 0;
      const mid = strip.getBoundingClientRect().left + strip.clientWidth / 2;
      let best = frames[0];
      let dist = Infinity;
      for (const f of frames) {
        const r = f.getBoundingClientRect();
        const d = Math.abs(r.left + r.width / 2 - mid);
        if (d < dist) { dist = d; best = f; }
      }
      frames.forEach((f) => f.classList.toggle('is-center', f === best));
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(mark); };
    strip.addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    const start = frames[Math.min(1, frames.length - 1)];
    if (strip.dataset.start !== 'first' && start && innerWidth > 700) {
      strip.scrollLeft = start.offsetLeft + start.offsetWidth / 2 - strip.clientWidth / 2;
    }
    mark();

    if (matchMedia('(pointer: fine)').matches) {
      let x0 = 0, s0 = 0, down = false, moved = false;
      strip.addEventListener('pointerdown', (e) => {
        if (e.pointerType !== 'mouse') return;
        down = true; moved = false; x0 = e.clientX; s0 = strip.scrollLeft;
      });
      addEventListener('pointermove', (e) => {
        if (!down) return;
        const dx = e.clientX - x0;
        if (Math.abs(dx) > 4) { moved = true; strip.classList.add('is-dragging'); }
        strip.scrollLeft = s0 - dx;
      });
      addEventListener('pointerup', () => {
        if (!down) return;
        down = false;
        if (moved) {
          strip.classList.remove('is-dragging');
          const mid = strip.scrollLeft + strip.clientWidth / 2;
          const target = frames.reduce((a, f) => Math.abs(f.offsetLeft + f.offsetWidth / 2 - mid) < Math.abs(a.offsetLeft + a.offsetWidth / 2 - mid) ? f : a);
          strip.scrollTo({ left: target.offsetLeft + target.offsetWidth / 2 - strip.clientWidth / 2, behavior: 'smooth' });
        }
      });
      strip.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);
    }
  });
</script>
