---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n';

interface Props { id: string; title: string; meta?: string; lang: Lang; sizes?: string; class?: string }
const { id, title, meta, lang, sizes = '(max-width: 860px) 100vw, 60vw', class: cls = '' } = Astro.props;
const posters = import.meta.glob<{ default: ImageMetadata }>('../assets/video-posters/*.jpg', { eager: true });
const poster = posters[`../assets/video-posters/${id}.jpg`]?.default;
const pl = lang === 'pl';
---

<figure class:list={['vf', cls]} data-vf={id}>
  <button class="vf__play" type="button" data-vf-play aria-label={`${pl ? 'Odtwórz wideo' : 'Play video'}: ${title}`}>
    {poster && <Image src={poster} alt="" widths={[480, 800, 1280]} sizes={sizes} class="vf__poster cover lit" />}
    <span class="vf__plate glass" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 1.5v13L14 8z" fill="currentColor" /></svg>
      <span>{pl ? 'Odtwórz' : 'Play'}</span>
    </span>
  </button>
  <figcaption class="vf__cap">
    <span class="vf__title">{title}</span>
    {meta && <span class="vf__meta">{meta}</span>}
  </figcaption>
</figure>

<style>
  .vf { display: grid; gap: 0.85rem; }
  .vf__play { position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; overflow: clip; background: var(--surface); }
  .vf__poster { transition: transform 900ms var(--ease-expo), filter 400ms ease; }
  .vf__plate {
    position: absolute; left: 1rem; bottom: 1rem; display: inline-flex; align-items: center; gap: 0.6rem;
    min-height: 2.75rem; padding: 0 1.1rem; color: var(--ink);
    transition: background-color var(--t-hover) ease, transform var(--t-press) var(--ease-out);
  }
  .vf__play:active .vf__plate { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) {
    .vf__play:hover .vf__poster { transform: scale(1.03); filter: brightness(1); }
    .vf__play:hover .vf__plate { background: var(--accent); }
  }
  .vf iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .vf__cap { display: grid; gap: 0.15rem; }
  .vf__title { font-size: var(--step-lead); line-height: 1.2; }
  .vf__meta { font-size: var(--step-small); color: var(--muted); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-vf]').forEach((fig) => {
    const btn = fig.querySelector<HTMLButtonElement>('[data-vf-play]');
    btn?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${fig.dataset.vf}?autoplay=1&rel=0&modestbranding=1`;
      frame.title = btn.getAttribute('aria-label') ?? 'YouTube';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      btn.replaceChildren(frame);
      btn.removeAttribute('aria-label');
      btn.style.cursor = 'default';
    }, { once: true });
  });
</script>
