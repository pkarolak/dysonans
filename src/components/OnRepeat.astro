---
import { Image } from 'astro:assets';
import cover from '../assets/covers/dysonans-2015.jpg';
import { signatureTrack as track } from '../data/site';
import { t, type Lang } from '../i18n';
import Icon from './Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const pl = lang === 'pl';
const url = `https://open.spotify.com/track/${track.spotifyTrack}`;
---

<section class="onrepeat tile tile--raised" aria-labelledby="onrepeat-title" data-onrepeat data-track={track.spotifyTrack} data-duration={track.duration}>
  <div class="onrepeat__cover inset">
    <Image src={cover} alt={pl ? 'Okładka albumu Dysonans 2015' : 'Dysonans 2015 album cover'} width={240} height={240} class="cover" />
  </div>
  <div class="onrepeat__body">
    <h2 id="onrepeat-title" class="onrepeat__label"><Icon name="repeat" size={16} />{pl ? 'Na okrągło' : 'On repeat'}</h2>
    <p class="onrepeat__title">{track.title}</p>
    <p class="onrepeat__meta">{track.composer} · {track.album}</p>
    <p class="onrepeat__why">{t(track.why, lang)}</p>
  </div>

  <div class="onrepeat__controls">
    <a class="onrepeat__play" href={url} target="_blank" rel="noopener" data-onrepeat-play aria-label={pl ? `Odtwórz ${track.title}` : `Play ${track.title}`}>
      <span data-icon-play><Icon name="play" weight="fill" size={20} /></span>
      <span data-icon-pause hidden><Icon name="pause" weight="fill" size={20} /></span>
    </a>
    <div class="onrepeat__track" data-onrepeat-seek role="slider" tabindex="-1" aria-label={pl ? 'Postęp utworu' : 'Track progress'} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <span class="onrepeat__fill" data-onrepeat-fill></span>
    </div>
    <span class="onrepeat__time nums"><span data-onrepeat-pos>0:00</span> / <span data-onrepeat-dur>{track.duration}</span></span>
    <a class="icon-button onrepeat__out" href={url} target="_blank" rel="noopener" aria-label={pl ? 'Otwórz w Spotify' : 'Open in Spotify'}><Icon name="spotify-logo" size={20} /></a>
  </div>
  <p class="onrepeat__note" data-onrepeat-note hidden>
    {pl ? 'To 30-sekundowy podgląd. Cały utwór usłyszysz po zalogowaniu do Spotify.' : 'This is a 30-second preview. Log in to Spotify to hear the whole track.'}
  </p>

  <div class="onrepeat__engine" data-onrepeat-engine aria-hidden="true"><div data-onrepeat-embed></div></div>
</section>

<style>
  .onrepeat { --p: 12px; --r: 26px; position: relative; display: grid; grid-template-columns: 8.5rem 1fr; gap: 1.25rem; align-items: start; }
  .onrepeat__cover { aspect-ratio: 1; }
  .onrepeat__body { padding: 0.35rem 0.5rem 0 0; }
  .onrepeat__label { display: inline-flex; align-items: center; gap: 0.4rem; font-size: var(--step-small); font-weight: 500; color: var(--accent-text); }
  .onrepeat__title { font-family: var(--font-display); font-size: var(--step-title); line-height: 1.1; margin-top: 0.35rem; }
  .onrepeat__meta { font-size: var(--step-small); color: var(--muted); margin-top: 0.25rem; }
  .onrepeat__why { font-size: var(--step-small); color: var(--muted); margin-top: 0.75rem; max-width: 42ch; }

  .onrepeat__controls {
    grid-column: 1 / -1; display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; gap: 0.9rem; align-items: center;
    padding: 6px 6px 6px 6px; border-radius: calc(var(--r) - var(--p)); background: var(--surface-3);
  }
  .onrepeat__play {
    display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: var(--r-pill);
    background: var(--accent); color: #fff; transition: transform var(--t-press) var(--ease-out), background-color var(--t-hover) ease;
  }
  .onrepeat__play:active { transform: scale(0.94); }
  .onrepeat__play :global(svg) { display: block; }
  [data-icon-play] :global(svg) { transform: translateX(1px); }
  .onrepeat__track { position: relative; height: 6px; border-radius: var(--r-pill); background: var(--line-strong); cursor: pointer; }
  .onrepeat__track::before { content: ''; position: absolute; inset: -10px 0; }
  .onrepeat__fill { position: absolute; inset: 0 auto 0 0; width: calc(var(--progress, 0) * 100%); border-radius: inherit; background: var(--ink); transition: width 300ms linear; }
  .onrepeat__time { font-size: var(--step-small); color: var(--muted); white-space: nowrap; }
  .onrepeat__out { width: 2.75rem; height: 2.75rem; }
  .onrepeat__note { grid-column: 1 / -1; margin-top: -0.5rem; padding-inline: 0.5rem; font-size: var(--step-small); color: var(--muted); }

  /* Spotify's embed does the playing; it stays loaded but out of sight unless the browser insists on a tap inside it. */
  .onrepeat__engine { position: absolute; left: 0; bottom: 0; width: 300px; height: 80px; opacity: 0; pointer-events: none; z-index: -1; }
  .onrepeat__engine :global(iframe) { display: block; width: 100%; height: 80px; border: 0; }
  .onrepeat.needs-tap .onrepeat__engine { position: static; grid-column: 1 / -1; width: 100%; opacity: 1; pointer-events: auto; z-index: auto; border-radius: calc(var(--r) - var(--p)); overflow: clip; }
  .onrepeat.needs-tap .onrepeat__controls, .onrepeat.needs-tap .onrepeat__note { display: none; }

  @media (hover: hover) and (pointer: fine) {
    .onrepeat__play:hover { background: var(--accent-strong); }
  }
  @media (max-width: 420px) {
    .onrepeat { grid-template-columns: 5.5rem 1fr; }
    .onrepeat__out { display: none; }
    .onrepeat__controls { grid-template-columns: auto minmax(0, 1fr) auto; padding-right: 1rem; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-onrepeat]');
  const q = <T extends Element>(s: string) => root?.querySelector<T>(s) ?? null;
  const play = q<HTMLAnchorElement>('[data-onrepeat-play]');
  const embed = q<HTMLElement>('[data-onrepeat-embed]');
  const seek = q<HTMLElement>('[data-onrepeat-seek]');
  const posEl = q<HTMLElement>('[data-onrepeat-pos]');
  const durEl = q<HTMLElement>('[data-onrepeat-dur]');
  const note = q<HTMLElement>('[data-onrepeat-note]');
  const iconPlay = q<HTMLElement>('[data-icon-play]');
  const iconPause = q<HTMLElement>('[data-icon-pause]');

  type Controller = { togglePlay(): void; play(): void; seek(s: number): void; addListener(ev: string, cb: (e: any) => void): void };
  let controller: Controller | null = null;
  let loading = false;
  let started = false;
  let duration = 0;

  const fmt = (ms: number) => {
    const s = Math.max(0, Math.round(ms / 1000));
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  };

  const setPlaying = (playing: boolean, progress: number) => {
    document.querySelectorAll<SVGElement>('[data-logo]').forEach((l) => {
      l.classList.toggle('is-playing', playing);
      l.style.setProperty('--progress', String(progress));
    });
    dispatchEvent(new CustomEvent('dysonans:tension', { detail: playing ? 1 - progress : 1 }));
  };

  if (root && play && embed && seek && posEl && durEl && note && iconPlay && iconPause) {
    const pl = document.documentElement.lang === 'pl';
    const title = root.querySelector('.onrepeat__title')?.textContent ?? '';
    const render = (paused: boolean, position: number) => {
      const progress = duration ? Math.min(1, position / duration) : 0;
      iconPlay.hidden = !paused;
      iconPause.hidden = paused;
      play.setAttribute('aria-label', paused ? (pl ? `Odtwórz ${title}` : `Play ${title}`) : (pl ? 'Pauza' : 'Pause'));
      root.style.setProperty('--progress', String(progress));
      seek.setAttribute('aria-valuenow', String(Math.round(progress * 100)));
      posEl.textContent = fmt(position);
      if (duration) durEl.textContent = fmt(duration);
      setPlaying(!paused, progress);
    };

    const load = () => {
      loading = true;
      (window as any).onSpotifyIframeApiReady = (api: any) => {
        api.createController(embed, { uri: `spotify:track:${root.dataset.track}`, width: '100%', height: 80 }, (c: Controller) => {
          controller = c;
          c.addListener('ready', () => {
            c.play();
            setTimeout(() => { if (!started) root.classList.add('needs-tap'); }, 3500);
          });
          c.addListener('playback_update', (ev: any) => {
            const { isPaused, position, duration: d } = ev.data;
            if (d) duration = d;
            if (!isPaused) started = true;
            note.hidden = !(duration > 0 && duration < 40000);
            render(isPaused, position);
          });
        });
      };
      const s = document.createElement('script');
      s.src = 'https://open.spotify.com/embed/iframe-api/v1';
      s.async = true;
      s.onerror = () => window.open(play.href, '_blank', 'noopener');
      document.head.append(s);
    };

    play.addEventListener('click', (e) => {
      e.preventDefault();
      if (controller) { controller.togglePlay(); return; }
      if (!loading) load();
    });

    seek.addEventListener('click', (e) => {
      if (!controller || !duration) return;
      const r = seek.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
      controller.seek((p * duration) / 1000);
    });
  }
</script>
