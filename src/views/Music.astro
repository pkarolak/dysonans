---
import Base from '../layouts/Base.astro';
import SpotifyAlbum from '../components/SpotifyAlbum.astro';
import VideoFacade from '../components/VideoFacade.astro';
import DragRow from '../components/DragRow.astro';
import LoopVideo from '../components/LoopVideo.astro';
import Icon from '../components/Icon.astro';
import { albums, contact, signatureTrack, videos } from '../data/site';
import { routes, t, type Lang } from '../i18n';
import type { ImageMetadata } from 'astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const pl = lang === 'pl';
const L = (p: string, e: string) => (pl ? p : e);

const covers = import.meta.glob<{ default: ImageMetadata }>('../assets/covers/*.jpg', { eager: true });
const cover = (id: string) => covers[`../assets/covers/${id}.jpg`].default;

const concerts = videos.filter((v) => v.kind === 'concert');
const [feature, ...rest] = concerts;
const films = videos.filter((v) => v.kind === 'film');
---

<Base
  lang={lang}
  page="music"
  title={L('Muzyka', 'Music')}
  description={L('Płyty Chóru Kameralnego Dysonans na Spotify i w sklepie, nagrania koncertowe i filmy z tras.', 'Dysonans Chamber Choir albums on Spotify and in the shop, concert recordings and tour films.')}
>
  <header class="page-head wrap music-head">
    <div>
      <h1 data-focus>{L('Muzyka', 'Music')}</h1>
      <p class="lead" data-focus style="--i:1">{L('Od Palestriny po Mäntyjärviego. Cztery płyty i koncerty, które można obejrzeć.', 'From Palestrina to Mäntyjärvi. Four albums and concerts you can watch.')}</p>
      <div class="head-actions" data-focus style="--i:2">
        <a class="button" href={contact.spotify} target="_blank" rel="noopener"><Icon name="spotify-logo" size={20} />{L('Dysonans na Spotify', 'Dysonans on Spotify')}</a>
        <a class="button button--ghost" href={contact.youtube} target="_blank" rel="noopener"><Icon name="youtube-logo" size={20} />YouTube</a>
      </div>
    </div>
    <div class="music-head__film" data-reveal>
      <LoopVideo name="scores-loop" eager label={L('Chórzyści śpiewają z nut', 'Singers reading from their scores')} />
    </div>
  </header>

  <section class="albums wrap" aria-labelledby="albums-title">
    <div class="section-head">
      <h2 id="albums-title" class="section-title" data-focus>{L('Płyty', 'Albums')}</h2>
      <span class="pill" data-focus style="--i:1"><Icon name="vinyl-record" size={18} />{albums.length} {L('albumy', 'albums')}</span>
    </div>
    <div class="albums__list">
      {albums.map((a) => (
        <article class="album panel" id={a.id} data-reveal>
          <div class="album__media inset">
            <SpotifyAlbum album={a.spotifyAlbum} cover={cover(a.id)} title={a.title} lang={lang} />
          </div>
          <div class="album__body">
            <p class="tile-kicker nums">{[a.year, a.label, a.catalogue].filter(Boolean).join(' · ')}</p>
            <h3 class="album__title">{a.title}</h3>
            <p class="album__note">{t(a.note, lang)}</p>
            {a.id === signatureTrack.albumId && (
              <a class="album__signature tile tile--flat" href={`https://open.spotify.com/track/${signatureTrack.spotifyTrack}`} target="_blank" rel="noopener">
                <span class="chip-icon"><Icon name="repeat" size={20} /></span>
                <span><span class="album__sig-k">{L('Na okrągło', 'On repeat')}</span><span class="album__sig-t">{signatureTrack.title} · {signatureTrack.composer}</span></span>
                <Icon name="arrow-up-right" size={18} />
              </a>
            )}
            <p class="meta"><Icon name="users-three" size={16} />{t(a.performers, lang)}</p>
            <details class="album__tracks">
              <summary><Icon name="list-bullets" size={18} />{L('Lista utworów', 'Tracklist')}<span class="nums muted">{a.tracks.length}</span><Icon name="caret-down" size={16} class="album__caret" /></summary>
              <ol>
                {a.tracks.map((tr) => <li><span>{tr.title}</span>{tr.composer && <span class="muted">{tr.composer}</span>}</li>)}
              </ol>
            </details>
            <div class="album__actions">
              {a.spotifyAlbum && <a class="button button--sm" href={`https://open.spotify.com/album/${a.spotifyAlbum}`} target="_blank" rel="noopener"><Icon name="spotify-logo" size={18} />{L('Otwórz w Spotify', 'Open in Spotify')}</a>}
              {a.buy && <a class="button button--sm button--ghost" href={`${routes.shop[lang]}#${a.id}`}><Icon name="shopping-bag-open" size={18} />{L(`Kup, ${a.buy.price}`, `Buy, ${a.buy.price}`)}</a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="videos" aria-labelledby="videos-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2 id="videos-title" class="section-title" data-focus>{L('Na żywo', 'Live')}</h2>
          <p class="lead" data-focus style="--i:1">{L('Nagrania z koncertów i konkursów. Wideo ładuje się dopiero po kliknięciu.', 'Recordings from concerts and competitions. Each video loads only when you press play.')}</p>
        </div>
        <span class="pill" data-focus style="--i:2"><Icon name="hand-grabbing" size={18} />{L('Przeciągnij w bok', 'Drag sideways')}</span>
      </div>
      <div class="videos__feature" data-reveal>
        <VideoFacade id={feature.id} title={feature.title} meta={`${feature.composer} · ${t(feature.era, lang)}`} lang={lang} sizes="(max-width: 860px) 100vw, 90vw" />
      </div>
    </div>
    <DragRow label={L('Więcej nagrań', 'More recordings')} class="videos__row">
      {rest.map((v) => (
        <div data-reveal><VideoFacade id={v.id} title={v.title} meta={`${v.composer} · ${t(v.era, lang)}`} lang={lang} sizes="(max-width: 860px) 78vw, 42rem" /></div>
      ))}
    </DragRow>
  </section>

  <section class="films wrap" aria-labelledby="films-title">
    <div class="section-head">
      <h2 id="films-title" class="section-title" data-focus>{L('Filmy', 'Films')}</h2>
    </div>
    <div class="films__grid">
      {films.map((v, i) => (
        <div class:list={['films__item', `films__item--${i}`]} data-reveal style={`--i:${i}`}>
          <VideoFacade id={v.id} title={v.title} meta={t(v.era, lang)} lang={lang} sizes="(max-width: 860px) 100vw, 50vw" />
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .music-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: var(--gutter); align-items: end; }
  .music-head__film { aspect-ratio: 4 / 5; overflow: clip; border-radius: var(--r-panel); box-shadow: var(--shadow-lg); }
  .music-head__film :global(video) { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.85) contrast(1.05); }
  @media (max-width: 860px) { .music-head { grid-template-columns: 1fr; gap: 2.5rem; } .music-head__film { aspect-ratio: 4 / 3; } }
  .head-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-top: 2rem; }

  .albums { padding-block: calc(var(--section) / 2); }
  .albums__list { display: grid; gap: var(--gutter); }
  .album { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: start; }
  .album__media { aspect-ratio: 1; }
  .album__body { display: grid; gap: 1rem; justify-items: start; padding: clamp(0.75rem, 2.5vw, 2.5rem) clamp(0.5rem, 2vw, 2rem) clamp(0.75rem, 2vw, 1.5rem) 0; }
  .album__title { font-family: var(--font-display); font-size: var(--step-head); line-height: 1; letter-spacing: -0.02em; }
  .album__note { max-width: 56ch; }
  .album__signature { --p: 0.75rem; display: grid; grid-template-columns: auto 1fr auto; gap: 0.85rem; align-items: center; width: 100%; max-width: 30rem; padding-right: 1.1rem; }
  .album__sig-k { display: block; font-size: var(--step-small); color: var(--accent-text); font-weight: 500; }
  .album__sig-t { display: block; font-weight: 500; }
  .album__tracks { width: 100%; border-block: 1px solid var(--line); }
  .album__tracks summary { display: flex; align-items: center; gap: 0.6rem; min-height: 3.25rem; padding: 0; cursor: pointer; list-style: none; font-weight: 500; }
  .album__tracks summary::-webkit-details-marker { display: none; }
  .album__tracks summary :global(.album__caret) { margin-left: auto; transition: transform 300ms var(--ease-out); }
  .album__tracks[open] summary :global(.album__caret) { transform: rotate(180deg); }
  .album__tracks ol { columns: 2; column-gap: 2rem; padding: 0.25rem 0 1.1rem 1.3rem; font-size: var(--step-small); }
  .album__tracks li { break-inside: avoid; padding-block: 0.3rem; }
  .album__tracks li span { display: block; }
  .album__actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.25rem; }

  .videos { padding-block: calc(var(--section) / 2); }
  .videos__row { margin-top: var(--gutter); }

  .films { padding-block: calc(var(--section) / 2) var(--section); }
  .films__grid { display: grid; grid-template-columns: 7fr 5fr; gap: var(--gutter); align-items: end; }

  @media (max-width: 860px) {
    .album { grid-template-columns: 1fr; }
    .album__body { padding: 0.5rem 0.75rem 0.75rem; }
    .album__tracks ol { columns: 1; }
    .films__grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
