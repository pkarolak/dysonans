---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LoopVideo from '../components/LoopVideo.astro';
import Icon from '../components/Icon.astro';
import { awards, counts, type Tier } from '../data/site';
import { routes, t, type Lang } from '../i18n';
import curtains from '../assets/photos/stage-red-curtains.jpg';
import stained from '../assets/photos/hall-stained-glass.jpg';
import wooden from '../assets/photos/wooden-church.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const pl = lang === 'pl';
const L = (p: string, e: string) => (pl ? p : e);

const grand = awards.filter((a) => a.tier === 'grand-prix');
const grandPics = [curtains, stained, wooden];
const sorted = [...awards].sort((a, b) => b.date.localeCompare(a.date));
const month = (d: string) => {
  const [y, m] = d.split('-').map(Number);
  return new Date(y, m - 1, 1).toLocaleDateString(pl ? 'pl-PL' : 'en-GB', { month: 'long' });
};

const tiers: Record<Tier, { icon: string; label: string }> = {
  'grand-prix': { icon: 'crown', label: 'Grand Prix' },
  first: { icon: 'medal', label: L('I miejsce', 'First place') },
  prize: { icon: 'seal-check', label: L('Nagroda', 'Prize') },
  stage: { icon: 'microphone-stage', label: L('Występ', 'Performance') },
};
const filters: { id: 'all' | Tier; label: string; n: number }[] = [
  { id: 'all', label: L('Wszystkie', 'All'), n: awards.length },
  ...(['grand-prix', 'first', 'prize', 'stage'] as Tier[]).map((id) => ({ id, label: tiers[id].label, n: awards.filter((a) => a.tier === id).length })),
].filter((f) => f.n > 0);
---

<Base
  lang={lang}
  page="awards"
  title={L('Nagrody', 'Awards')}
  description={L(`Grand Prix, ${counts.firsts} pierwszych miejsc i konkursy w ${counts.countries} krajach. Pełna lista nagród Chóru Kameralnego Dysonans od 2008 roku.`, `Grand Prix wins, ${counts.firsts} first places and competitions in ${counts.countries} countries. The full list of Dysonans awards since 2008.`)}
>
  <header class="page-head wrap">
    <h1 data-focus>{L('Nagrody', 'Awards')}</h1>
    <p class="lead" data-focus style="--i:1">
      {L(`Od 2008 roku: ${counts.grandPrix} Grand Prix, ${counts.firsts} pierwszych miejsc w kategoriach i konkursy w ${counts.countries} krajach, od Gorycji po Boliwię.`, `Since 2008: ${counts.grandPrix} Grand Prix, ${counts.firsts} category first places and competitions in ${counts.countries} countries, from Gorizia to Bolivia.`)}
    </p>
  </header>

  <section class="gp wrap" aria-labelledby="gp-title">
    <div class="section-head">
      <h2 id="gp-title" class="section-title" data-focus>{L('Trzy razy Grand Prix', 'Three times Grand Prix')}</h2>
    </div>
    <ol class="gp__grid">
      {grand.map((a, i) => (
        <li class="gp__tile panel" data-reveal style={`--i:${i}`}>
          <div class="gp__photo inset on-media">
            <Image src={grandPics[i % grandPics.length]} alt="" widths={[500, 900]} sizes="(max-width: 860px) 100vw, 30vw" class="cover" />
            <span class="gp__year nums">{a.year}</span>
            <span class="gp__crown glass"><Icon name="crown" weight="fill" size={20} /></span>
          </div>
          <div class="gp__body">
            <h3 class="tile-title">{t(a.event, lang)}</h3>
            <p class="meta"><Icon name="map-pin" size={16} />{t(a.city, lang)}, {t(a.country, lang)}</p>
            {a.results.length > 1 && (
              <ul class="checks">
                {a.results.slice(1).map((r) => <li><Icon name="check" size={16} weight="bold" />{t(r, lang)}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="moment wrap" aria-labelledby="moment-title">
    <div class="moment__frame on-media">
      <div class="moment__media">
        <LoopVideo name="hero-gorizia" label={L('Dysonans na scenie w Gorycji, 2016', 'Dysonans on stage in Gorizia, 2016')} />
      </div>
      <div class="moment__card glass">
        <span class="pill moment__pill"><Icon name="film-strip" size={16} />{L('Z archiwum', 'From the archive')}</span>
        <h2 id="moment-title" class="moment__title">{L('Gorycja, lipiec 2016', 'Gorizia, July 2016')}</h2>
        <p>{L('Na konkursie Seghizzi: I miejsce za muzykę barokową, II za renesansową, nagroda „Domenico Cieri” za program i 5. miejsce w konkursie o Grand Prix.', 'At the Seghizzi competition: first place for Baroque music, second for Renaissance, the “Domenico Cieri” prize for the programme and fifth place in the Grand Prix.')}</p>
      </div>
    </div>
  </section>

  <section class="all wrap" aria-labelledby="all-title" data-awards>
    <div class="section-head">
      <h2 id="all-title" class="section-title" data-focus>{L('Wszystko po kolei', 'Everything, in order')}</h2>
      <div class="filters" role="group" aria-label={L('Pokaż', 'Show')} data-focus style="--i:1">
        {filters.map((f, i) => (
          <button type="button" class="filter" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={f.id}>
            {f.label}<span class="filter__n nums">{f.n}</span>
          </button>
        ))}
      </div>
    </div>
    <ul class="awards__grid">
      {sorted.map((a) => (
        <li class:list={['award tile', `award--${a.tier}`]} data-tier={a.tier} data-reveal>
          <div class="award__top">
            <span class:list={['chip-icon', a.tier === 'stage' && 'chip-icon--neutral']}><Icon name={tiers[a.tier].icon} weight="duotone" size={22} /></span>
            <span class="award__tier">{tiers[a.tier].label}</span>
            <span class="award__year pill nums">{a.year}</span>
          </div>
          <h3 class="tile-title">{t(a.event, lang)}</h3>
          <p class="meta">
            <span><Icon name="map-pin" size={16} />{t(a.city, lang)}, {t(a.country, lang)}</span>
            <span><Icon name="calendar-blank" size={16} />{month(a.date)}</span>
          </p>
          <ul class="checks">
            {a.results.map((r) => <li><Icon name="check" size={16} weight="bold" />{t(r, lang)}</li>)}
          </ul>
        </li>
      ))}
    </ul>
    <p class="all__more" data-reveal>
      <a class="button" href={routes.music[lang]}><Icon name="headphones" size={18} />{L('Posłuchaj, jak to brzmi', 'Hear how it sounds')}</a>
    </p>
  </section>
</Base>

<style>
  .gp { padding-block: calc(var(--section) / 3) calc(var(--section) / 2); }
  .gp__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); }
  .gp__tile { display: grid; grid-template-rows: auto 1fr; }
  .gp__photo { position: relative; aspect-ratio: 4 / 3; }
  .gp__photo :global(img) { filter: brightness(0.55); }
  .gp__year { position: absolute; left: 1.25rem; bottom: 0.9rem; font-family: var(--font-display); font-size: clamp(3rem, 2rem + 3vw, 5rem); line-height: 1; color: var(--ink); letter-spacing: -0.03em; }
  .gp__crown { position: absolute; top: 12px; right: 12px; width: 2.75rem; height: 2.75rem; display: grid; place-items: center; border-radius: var(--r-pill); color: #FFD27A; }
  .gp__body { display: grid; align-content: start; gap: 0.6rem; padding: 1.25rem 1rem 1rem; }

  .checks { display: grid; gap: 0.45rem; margin-top: 0.35rem; }
  .checks li { display: grid; grid-template-columns: 1rem 1fr; gap: 0.6rem; align-items: start; line-height: 1.4; }
  .checks :global(svg) { margin-top: 0.2em; color: var(--accent-text); }

  .moment { padding-block: calc(var(--section) / 2); }
  .moment__frame { --r: var(--r-panel); --p: var(--p-panel); position: relative; min-height: 80svh; display: grid; align-items: end; overflow: clip; border-radius: var(--r); box-shadow: var(--shadow-lg); isolation: isolate; background: #000; }
  .moment__media { position: absolute; inset: 0; z-index: -1; }
  .moment__media :global(video) { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.6); }
  .moment__card { margin: var(--p); padding: clamp(1.5rem, 3vw, 2.25rem); max-width: 36rem; display: grid; gap: 0.9rem; justify-items: start; border-radius: calc(var(--r) - var(--p)); }
  .moment__pill { background: rgb(255 255 255 / 0.1); }
  .moment__title { font-family: var(--font-display); font-size: var(--step-title); line-height: 1.05; }

  .all { padding-block: calc(var(--section) / 2) var(--section); }
  .filters { display: flex; flex-wrap: wrap; gap: 6px; padding: 6px; border-radius: var(--r-pill); background: var(--surface); box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--line); }
  .filter {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.5rem; padding: 0 1rem; border-radius: var(--r-pill);
    font-weight: 500; font-size: var(--step-small); color: var(--muted); transition: background 250ms ease, color 250ms ease;
  }
  .filter:hover { color: var(--ink); }
  .filter[aria-pressed='true'] { background: var(--ink); color: var(--bg); }
  .filter__n { font-size: 0.8em; opacity: 0.7; }

  .awards__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); }
  .award { display: grid; align-content: start; gap: 0.75rem; }
  .award[hidden] { display: none; }
  .award__top { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.4rem; }
  .award__year { margin-left: auto; min-height: 2rem; }
  .award__tier { font-size: var(--step-small); font-weight: 500; color: var(--muted); }
  .award--grand-prix .award__tier, .award--first .award__tier { color: var(--accent-text); }
  .award .meta { display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; }
  .award .meta span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .award--stage .checks { color: var(--muted); }
  .all__more { margin-top: 4rem; }

  @media (max-width: 1100px) { .gp__grid, .awards__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 700px) {
    .awards__grid, .gp__grid { grid-template-columns: 1fr; }
    .filters { border-radius: 22px; }
    .moment__frame { min-height: 70svh; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-awards]');
  if (root) {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    buttons.forEach((b) => b.addEventListener('click', () => {
      const f = b.dataset.filter;
      const apply = () => {
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        root.querySelectorAll<HTMLElement>('[data-tier]').forEach((a) => {
          const on = f === 'all' || a.dataset.tier === f;
          a.hidden = !on;
          if (on) a.classList.add('is-in');
        });
      };
      const d = document as Document & { startViewTransition?: (cb: () => void) => unknown };
      if (d.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.startViewTransition(apply);
      else apply();
    }));
  }
</script>
