---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { conductors, contact } from '../data/site';
import { routes, t, type Lang } from '../i18n';
import white from '../assets/photos/white-church.jpg';
import scores from '../assets/photos/scores-closeup.jpg';
import nave from '../assets/photos/rome-st-peters-nave.jpg';
import LoopVideo from '../components/LoopVideo.astro';
import Icon from '../components/Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const pl = lang === 'pl';
const L = (p: string, e: string) => (pl ? p : e);
const mail = (subject: string, body = '') => `mailto:${contact.email}?subject=${encodeURIComponent(subject)}${body ? `&body=${encodeURIComponent(body)}` : ''}`;

const intents = [
  {
    icon: 'ticket',
    h: L('Zaproś nas na koncert', 'Invite us to sing'),
    p: L('Koncerty, festiwale, uroczystości. Napisz, gdzie i kiedy, a odpowiemy z propozycją repertuaru.', 'Concerts, festivals, ceremonies. Tell us where and when and we will reply with a repertoire proposal.'),
    a: { href: mail(L('Zaproszenie na koncert', 'Concert invitation'), L('Dzień dobry,\n\nData:\nMiejsce:\nOkazja:\n', 'Hello,\n\nDate:\nVenue:\nOccasion:\n')), label: L('Napisz w sprawie koncertu', 'Write about a concert') },
  },
  {
    icon: 'microphone-stage',
    h: L('Śpiewaj z nami', 'Sing with us'),
    p: L('Śpiewają u nas studenci i absolwenci poznańskich uczelni. Napisz, jaki masz głos i gdzie śpiewałeś.', 'Our singers are students and graduates of Poznań universities. Tell us your voice part and where you have sung.'),
    a: { href: mail(L('Chcę śpiewać w Dysonansie', 'I would like to sing with Dysonans')), label: L('Zgłoś się', 'Get in touch') },
  },
  {
    icon: 'vinyl-record',
    h: L('Kup płytę', 'Buy a CD'),
    p: L('Trzy płyty są w sprzedaży w Music Island albo bezpośrednio od nas.', 'Three CDs are on sale at Music Island or directly from us.'),
    a: { href: routes.shop[lang], label: L('Przejdź do sklepu', 'Go to the shop') },
  },
];
---

<Base
  lang={lang}
  page="contact"
  title={L('Kontakt', 'Contact')}
  description={L('Kontakt z Chórem Kameralnym Dysonans: koncerty, przesłuchania, płyty. Stowarzyszenie Promocji Kultury Cantamen, Poznań.', 'Contact the Dysonans Chamber Choir: concerts, auditions, CDs. Cantamen Association, Poznań.')}
>
  <header class="page-head wrap contact-head">
    <div>
      <h1 data-focus>{L('Kontakt', 'Contact')}</h1>
      <p class="lead" data-focus style="--i:1">{L('Napisz albo zadzwoń do Chóru Kameralnego Dysonans: koncerty, przesłuchania, płyty.', 'Write to or call the Dysonans Chamber Choir about concerts, auditions or CDs.')}</p>
      <div class="reach">
        <a class="reach__tile tile tile--hover" href={`mailto:${contact.email}`} data-focus style="--i:2">
          <span class="chip-icon"><Icon name="envelope-simple" weight="duotone" size={24} /></span>
          <span><span class="reach__k">E-mail</span><span class="reach__v">{contact.email}</span></span>
          <Icon name="arrow-up-right" size={20} class="reach__go" />
        </a>
        <a class="reach__tile tile tile--hover" href={contact.phoneHref} data-focus style="--i:3">
          <span class="chip-icon"><Icon name="phone" weight="duotone" size={24} /></span>
          <span><span class="reach__k">{L('Telefon', 'Phone')}</span><span class="reach__v nums">{contact.phone}</span></span>
          <Icon name="arrow-up-right" size={20} class="reach__go" />
        </a>
      </div>
    </div>
    <figure class="contact-pic" data-reveal>
      <LoopVideo name="hero-gorizia" eager label={L('Dysonans na scenie w Gorycji', 'Dysonans on stage in Gorizia')} />
    </figure>
  </header>

  <section class="intents wrap" aria-labelledby="intents-title">
    <div class="section-head">
      <h2 id="intents-title" class="section-title" data-focus>{L('W jakiej sprawie?', 'What is it about?')}</h2>
    </div>
    <ul class="intents__list">
      {intents.map((it, i) => (
        <li data-reveal style={`--i:${i}`}>
          <a class="intent tile tile--hover" href={it.a.href}>
            <span class="chip-icon"><Icon name={it.icon} weight="duotone" size={24} /></span>
            <h3 class="tile-title">{it.h}</h3>
            <p class="intent__p">{it.p}</p>
            <span class="arrow-link">{it.a.label}<Icon name="arrow-right" size={18} /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="org wrap" aria-labelledby="org-title">
    <div class="org__pics">
      <figure class="org__pic rounded shutter" data-reveal>
        <Image src={white} alt={L('Chór śpiewa w jasnym kościele', 'The choir sings in a white church')} widths={[600, 1000]} sizes="(max-width: 860px) 90vw, 30vw" class="cover" />
      </figure>
      <figure class="org__pic org__pic--small rounded shutter" data-reveal style="--i:1">
        <Image src={scores} alt={L('Nuty w dłoniach chórzystów', 'Scores in the singers’ hands')} widths={[400, 700]} sizes="(max-width: 860px) 50vw, 18vw" class="cover" />
      </figure>
      <figure class="org__pic org__pic--small rounded shutter" data-reveal style="--i:2">
        <Image src={nave} alt={L('Chór w nawie Bazyliki św. Piotra', 'The choir in the nave of St Peter’s')} widths={[400, 700]} sizes="(max-width: 860px) 50vw, 18vw" class="cover" />
      </figure>
    </div>
    <div class="org__text">
      <h2 id="org-title" class="section-title" data-focus>{L('Kto za nami stoi', 'Who runs the choir')}</h2>
      <dl class="org__list" data-reveal>
        <div class="org__row"><dt>{L('Organizacja', 'Organisation')}</dt><dd>{t(contact.association, lang)}</dd></div>
        <div class="org__row"><dt>NIP</dt><dd class="nums">{contact.nip}</dd></div>
        <div class="org__row">
          <dt>{L('Konto', 'Bank account')}</dt>
          <dd class="org__account"><span><span class="nums">{contact.bank.account}</span><span class="muted small">{contact.bank.name}</span></span>
            <button class="icon-button org__copy" type="button" data-copy={contact.bank.account.replace(/\s/g, '')} aria-label={L('Skopiuj numer konta', 'Copy account number')}>
              <span data-copy-icon="copy"><Icon name="copy" size={20} /></span><span data-copy-icon="done" hidden><Icon name="check" size={20} weight="bold" /></span>
            </button>
          </dd>
        </div>
        <div class="org__row"><dt>{L('Biuro', 'Office')}</dt><dd><a class="link" href={`mailto:${contact.emailOffice}`}>{contact.emailOffice}</a></dd></div>
        <div class="org__row"><dt>{L('Dyrygenci', 'Conductors')}</dt><dd>{conductors.map((c) => c.name).join(', ')}</dd></div>
      </dl>
      <p class="org__status small muted" role="status" data-copy-status></p>
    </div>
  </section>
</Base>

<style>
  .contact-head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--gutter); align-items: end; }
  .contact-head .lead { margin-top: 1.25rem; }
  .reach { display: grid; gap: var(--gutter); margin-top: 2.5rem; max-width: 40rem; }
  .reach__tile { display: grid; grid-template-columns: auto 1fr auto; gap: 1.1rem; align-items: center; }
  .reach__k { display: block; color: var(--muted); font-size: var(--step-small); font-weight: 500; }
  .reach__v { display: block; font-size: var(--step-title); line-height: 1.15; font-weight: 500; letter-spacing: -0.01em; overflow-wrap: anywhere; }
  .reach__tile :global(.reach__go) { color: var(--muted); transition: transform 300ms var(--ease-out), color 300ms ease; }
  .reach__tile:hover :global(.reach__go) { transform: translate(2px, -2px); color: var(--ink); }
  .contact-pic { aspect-ratio: 4 / 5; overflow: clip; border-radius: var(--r-panel); box-shadow: var(--shadow-lg); }
  .contact-pic :global(video) { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.8) contrast(1.05); }

  .intents { padding-block: var(--section) calc(var(--section) / 2); }
  .intents__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); }
  .intents__list > li { display: grid; }
  .intent { display: grid; gap: 0.9rem; align-content: start; grid-template-rows: auto auto 1fr auto; }
  .intent .chip-icon { margin-bottom: 1.5rem; }
  .intent__p { color: var(--muted); }

  .org { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; padding-block: calc(var(--section) / 2) var(--section); }
  .org__pics { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); }
  .org__pic { aspect-ratio: 4 / 3; grid-column: 1 / -1; box-shadow: var(--shadow); }
  .org__pic--small { grid-column: auto; aspect-ratio: 1; }
  .org__list { display: grid; margin-top: 2rem; border-top: 1px solid var(--line); }
  .org__row { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; align-items: baseline; padding-block: 1rem; border-bottom: 1px solid var(--line); }
  .org__row dt { color: var(--muted); font-size: var(--step-small); font-weight: 500; }
  .org__row dd { font-weight: 500; }
  .org__account { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .org__account > span { display: grid; }
  .org__status { min-height: 1.5em; margin-top: 0.75rem; }

  @media (max-width: 1000px) { .intents__list { grid-template-columns: 1fr; } .intent .chip-icon { margin-bottom: 0.5rem; } }
  @media (max-width: 860px) {
    .contact-head, .org { grid-template-columns: 1fr; }
    .org__row { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const copyIcon = btn.querySelector<HTMLElement>('[data-copy-icon="copy"]');
    const doneIcon = btn.querySelector<HTMLElement>('[data-copy-icon="done"]');
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    const pl = document.documentElement.lang === 'pl';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        if (copyIcon && doneIcon) { copyIcon.hidden = true; doneIcon.hidden = false; }
        if (status) status.textContent = pl ? 'Numer konta skopiowany.' : 'Account number copied.';
      } catch {
        if (status) status.textContent = btn.dataset.copy ?? '';
      }
      setTimeout(() => {
        if (copyIcon && doneIcon) { copyIcon.hidden = false; doneIcon.hidden = true; }
        if (status) status.textContent = '';
      }, 2200);
    });
  });
</script>
