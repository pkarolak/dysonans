---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import LoopVideo from '../components/LoopVideo.astro';
import Strip, { type Frame } from '../components/Strip.astro';
import ResolveIt from '../components/ResolveIt.astro';
import Icon from '../components/Icon.astro';
import { albums, concerts, counts, contact } from '../data/site';
import { routes, t, type Lang } from '../i18n';

import scores from '../assets/photos/scores-closeup.jpg';
import golden from '../assets/photos/choir-golden-church.jpg';
import madonna from '../assets/photos/church-madonna.jpg';
import magdalena from '../assets/photos/magdalena-portrait.jpg';
import michal from '../assets/photos/michal-plichta.jpg';
import churchConcert from '../assets/photos/church-concert.jpg';
import nave from '../assets/photos/rome-st-peters-nave.jpg';
import altar from '../assets/photos/rome-st-peters-altar.jpg';
import stained from '../assets/photos/hall-stained-glass.jpg';
import curtains from '../assets/photos/stage-red-curtains.jpg';
import wooden from '../assets/photos/wooden-church.jpg';
import white from '../assets/photos/white-church.jpg';
import bells from '../assets/video-posters/1D5B-JYkZKg.jpg';
import bolivia from '../assets/video-posters/ujEyS3X6KIM.jpg';
import carnival from '../assets/video-posters/rSwlNdnzYEo.jpg';
import coverAche from '../assets/covers/a-che-angele.jpg';
import coverSalve from '../assets/covers/salve-regina.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const pl = lang === 'pl';
const L = (p: string, e: string) => (pl ? p : e);

const frames: Frame[] = [
  { src: curtains, alt: L('Chór na scenie przed czerwoną kurtyną', 'The choir on stage in front of a red curtain'), caption: 'The Lamb · John Tavener' },
  { src: altar, alt: L('Chór pod baldachimem Berniniego w Bazylice św. Piotra', 'The choir beneath Bernini’s baldachin in St Peter’s'), caption: L('Bazylika św. Piotra, Rzym', 'St Peter’s Basilica, Rome') },
  { src: wooden, alt: L('Chór w drewnianym kościele', 'The choir in a wooden church'), caption: 'Vox in Rama · Mikołaj Zieleński' },
  { src: stained, alt: L('Koncert w sali z witrażami', 'A concert in a hall with stained glass'), caption: 'The Lamb · John Tavener' },
  { src: bolivia, alt: L('Chórzyści na lotnisku przed wylotem do Boliwii', 'Singers at the airport before flying to Bolivia'), caption: L('Boliwia, dzień zero', 'Bolivia, day zero') },
  { src: churchConcert, alt: L('Chór w prezbiterium kościoła', 'The choir in a church chancel'), caption: 'Tu es Petrus · Palestrina' },
  { src: white, alt: L('Chór w jasnym kościele', 'The choir in a white church'), caption: L('Zimowa droga · Wissarion Szebalin', 'Winter Road · Vissarion Shebalin') },
  { src: bells, alt: L('Chórzyści w czapkach Mikołaja', 'Singers in Santa hats'), caption: 'Jingle Bells · opr. Jerzy Mackiewicz' },
  { src: nave, alt: L('Nawa Bazyliki św. Piotra podczas występu', 'The nave of St Peter’s during a performance'), caption: L('Bazylika św. Piotra, Rzym', 'St Peter’s Basilica, Rome') },
  { src: carnival, alt: L('Kadr z filmu „Wiele pasji, jedna miłość”', 'A still from the film “Many passions, one love”'), caption: L('Wiele pasji, jedna miłość', 'Many passions, one love') },
  { src: madonna, alt: L('Chór przed ołtarzem z obrazem Madonny', 'The choir before an altar with a Madonna'), caption: 'Cantate Domino · Claudio Monteverdi' },
  { src: golden, alt: L('Chór w złoconym kościele', 'The choir in a gilded church'), caption: 'Cantate Domino · Claudio Monteverdi' },
];

const ache = albums.find((a) => a.id === 'a-che-angele')!;
const salve = albums.find((a) => a.id === 'salve-regina')!;
const showcase = [
  { album: salve, cover: coverSalve, bg: altar, bgAlt: L('Chór przed ołtarzem Bazyliki św. Piotra', 'The choir before the altar of St Peter’s'), badge: L('Nowość 2025', 'New in 2025'), variant: L('RecArt 0073 · pierwsze nagranie', 'RecArt 0073 · first recording') },
  { album: ache, cover: coverAche, bg: golden, bgAlt: L('Chór śpiewa w złoconym kościele', 'The choir sings in a gilded church'), badge: L('Na żywo', 'Live'), variant: L('Cantamen CAN 004 · nagranie koncertowe', 'Cantamen CAN 004 · live recording') },
];

const stats = [
  { icon: 'calendar-blank', n: '1991', h: L('Rok pierwszej próby', 'Our first rehearsal'), s: L('Od tamtej pory chór prowadzi Magdalena Wdowicka-Mackiewicz.', 'Magdalena Wdowicka-Mackiewicz has led the choir ever since.') },
  { icon: 'crown', n: String(counts.grandPrix), h: 'Grand Prix', s: L('Międzyzdroje 2011, Łódź 2012, Bielsko-Biała 2022.', 'Międzyzdroje 2011, Łódź 2012, Bielsko-Biała 2022.') },
  { icon: 'medal', n: String(counts.firsts), h: L('Pierwszych miejsc', 'First places'), s: L('W kategoriach konkursowych od 2008 roku.', 'In competition categories since 2008.') },
  { icon: 'globe-hemisphere-west', n: String(counts.countries), h: L('Krajów', 'Countries'), s: L('Konkursy i festiwale od Boliwii po Meksyk.', 'Competitions and festivals from Bolivia to Mexico.') },
];

const milestones = [
  { year: '1994', icon: 'medal', h: L('I nagroda, Ogólnopolski Konkurs Dyrygentów Chóralnych', 'First prize, Polish National Choral Conducting Competition'), s: L('Dwa lata po II nagrodzie w tym samym konkursie.', 'Two years after taking second prize at the same competition.') },
  { year: '2016', icon: 'seal-check', h: L('Nagroda „Domenico Cieri”, Gorycja', 'The “Domenico Cieri” prize, Gorizia'), s: L('Za program o najwyższych walorach artystycznych na konkursie Seghizzi.', 'For the programme of the highest artistic value at the Seghizzi competition.') },
  { year: '2017', icon: 'microphone-stage', h: L('Finał w Londynie', 'The final in London'), s: L('London International A Cappella Choir Competition Petera Phillipsa z The Tallis Scholars.', 'The London International A Cappella Choir Competition run by Peter Phillips of The Tallis Scholars.') },
  { year: '2022', icon: 'crown', h: L('Grand Prix i nagroda dla najlepszego dyrygenta', 'Grand Prix and the best conductor award'), s: L('17. Międzynarodowy Festiwal Chórów „Gaude Cantem”, Bielsko-Biała.', 'The 17th Gaude Cantem International Choir Festival, Bielsko-Biała.') },
];

const join = `mailto:${contact.email}?subject=${encodeURIComponent(L('Chcę śpiewać w Dysonansie', 'I would like to sing with Dysonans'))}&body=${encodeURIComponent(L('Dzień dobry,\n\nśpiewam (głos): \nDoświadczenie chóralne: \nUczelnia / kierunek: \n', 'Hello,\n\nMy voice part: \nChoral experience: \nUniversity / course: \n'))}`;
const invite = `mailto:${contact.email}?subject=${encodeURIComponent(L('Zaproszenie na koncert', 'Concert invitation'))}`;
---

<Base
  lang={lang}
  page="home"
  title={L('Chór Kameralny Dysonans · Poznań', 'Dysonans Chamber Choir · Poznań')}
  description={L('Chór kameralny z Poznania, od 1991 roku. Grand Prix, nagrania, festiwal Muzyka Warta Słuchania.', 'A chamber choir from Poznań, since 1991. Grand Prix winners, recordings and the Muzyka Warta Słuchania festival.')}
  navOver
  onRepeat
>
  <section class="hero on-media" aria-labelledby="hero-title">
    <div class="hero__media">
      <LoopVideo name="hero-gorizia" eager label={L('Chór Dysonans na scenie konkursu Seghizzi w Gorycji, 2016', 'Dysonans on stage at the Seghizzi competition in Gorizia, 2016')} />
    </div>
    <h1 id="hero-title" class="hero__title">
      <span class="sr-only">{L('Chór Kameralny Dysonans', 'Dysonans Chamber Choir')}</span>
      <Logo animate label="Dysonans" />
    </h1>
    <div class="hero__foot">
      <p class="hero__line" data-focus style="--i:8">{L('Chór kameralny z Poznania. Śpiewamy od 1991 roku.', 'A chamber choir from Poznań, singing since 1991.')}</p>
      <div class="hero__actions" data-focus style="--i:9">
        <a class="button" href="#nastroj"><Icon name="fork" size={18} />{L('Nastrój chór', 'Tune the choir')}</a>
        <a class="button button--ghost hero__ghost glass" href={routes.music[lang]}><Icon name="play" weight="fill" size={16} />{L('Posłuchaj', 'Listen')}</a>
      </div>
    </div>
    <p class="hero__credit glass" data-focus style="--i:10"><Icon name="map-pin" size={16} />{L('Gorycja, Grand Prix Seghizzi, 2016', 'Gorizia, Seghizzi Grand Prix, 2016')}</p>
  </section>

  <section class="maestra wrap" aria-labelledby="maestra-title">
    <div class="maestra__panel panel">
      <figure class="maestra__portrait inset" data-reveal>
        <Image src={magdalena} alt={L('Magdalena Wdowicka-Mackiewicz, portret', 'Magdalena Wdowicka-Mackiewicz, portrait')} widths={[600, 900, 1300]} sizes="(max-width: 860px) 100vw, 40vw" class="cover" />
        <figcaption class="maestra__badge glass on-media"><Icon name="music-notes-simple" size={16} />{L('Dyrygentka od 1991 roku', 'Conductor since 1991')}</figcaption>
      </figure>
      <div class="maestra__story">
        <span class="pill maestra__pill" data-focus><Icon name="crown" weight="fill" size={16} />{L('Od pierwszej próby', 'Since the first rehearsal')}</span>
        <h2 id="maestra-title" class="maestra__name" data-focus style="--i:1">Magdalena<br />Wdowicka-Mackiewicz</h2>
        <p class="maestra__lead" data-focus style="--i:2">
          {L('W 1991 roku stanęła przed grupą studentów poznańskich uczelni i od tamtej pory nie oddała batuty. Trzydzieści pięć lat, trzy Grand Prix i sceny od Gorycji po misje jezuickie w Boliwii.', 'In 1991 she stood in front of a group of Poznań students and has not handed over the baton since. Thirty-five years, three Grand Prix, and stages from Gorizia to the Jesuit missions of Bolivia.')}
        </p>
        <p class="maestra__text" data-focus style="--i:3">
          {L('Profesor sztuk muzycznych i dyrektor Instytutu Dyrygentury poznańskiej Akademii Muzycznej. Z jej klasy wyszło 27 dyrygentów, którzy prowadzą dziś chóry w Polsce i za granicą. Renesans i barok to jej żywioł, a od 2018 roku przywraca do życia barok misyjny Ameryki Południowej, rekonstruowany przez ks. prof. Piotra Nawrota.', 'Professor of musical arts and director of the Conducting Institute at the Poznań Academy of Music. Twenty-seven conductors have graduated from her class and now lead choirs in Poland and abroad. Renaissance and Baroque music is her element, and since 2018 she has been bringing South American mission baroque back to life, reconstructed by Fr Prof. Piotr Nawrot.')}
        </p>
        <ol class="maestra__milestones">
          {milestones.map((m, i) => (
            <li class="milestone" data-reveal style={`--i:${i}`}>
              <span class="milestone__year nums">{m.year}</span>
              <span class="chip-icon"><Icon name={m.icon} weight="duotone" size={20} /></span>
              <span class="milestone__text"><strong>{m.h}</strong><span>{m.s}</span></span>
            </li>
          ))}
        </ol>
        <ul class="maestra__facts" data-focus style="--i:4">
          <li><span class="nums">35</span>{L('lat z Dysonansem', 'years with Dysonans')}</li>
          <li><span class="nums">27</span>{L('dyrygentów z jej klasy', 'conductors from her class')}</li>
          <li><span class="nums">3</span>Grand Prix</li>
        </ul>
      </div>
    </div>

    <div class="maestra__foot">
      <p class="maestra__credit small muted">{L('Zdjęcia: archiwum chóru; Michał Plichta, fot. Julia Konstanciak.', 'Photos: choir archive; Michał Plichta, photo by Julia Konstanciak.')}</p>
      <article class="apprentice tile" data-reveal>
        <Image src={michal} alt={L('Michał Plichta, portret', 'Michał Plichta, portrait')} width={160} height={160} class="apprentice__photo" />
        <div class="apprentice__text">
          <p class="tile-kicker">{L('Drugi dyrygent od 2023 · absolwent klasy prof. Wdowickiej-Mackiewicz', 'Second conductor since 2023 · a graduate of Prof. Wdowicka-Mackiewicz’s class')}</p>
          <h3 class="apprentice__name">Michał Plichta</h3>
          <p class="apprentice__bio">{L('Z Dysonansem nagrał „Salve Regina” Eustachiusa Wagnera i zdobył I nagrodę na festiwalu „Pater Noster” w 2024 roku.', 'With Dysonans he recorded Eustachius Wagner’s “Salve Regina” and won first prize at the “Pater Noster” festival in 2024.')}</p>
        </div>
      </article>
    </div>
  </section>

  <section class="rooms" aria-labelledby="rooms-title">
    <div class="wrap section-head">
      <div>
        <h2 id="rooms-title" class="section-title" data-focus>{L('Gdzie nas słychać', 'Where we are heard')}</h2>
        <p class="lead" data-focus style="--i:1">{L('Bazyliki, drewniane kościoły i sceny konkursowe.', 'Basilicas, wooden churches and competition stages.')}</p>
      </div>
      <span class="pill" data-focus style="--i:2"><Icon name="hand-grabbing" size={18} />{L('Przeciągnij w bok', 'Drag sideways')}</span>
    </div>
    <div data-reveal>
      <Strip frames={frames} label={L('Zdjęcia z koncertów', 'Concert photographs')} />
    </div>
  </section>

  <section class="name wrap" aria-labelledby="name-title">
    <div class="name__grid">
      <div class="name__pin">
        <span class="pill name__pill" data-focus><Icon name="fork" size={16} />{L('Skąd ta nazwa', 'Why the name')}</span>
        <h2 id="name-title" class="statement" data-focus style="--i:1">
          {L('Dysonans to współbrzmienie, które chce się rozwiązać.', 'A dissonance is a chord that wants to resolve.')}
        </h2>
        <p class="name__note lead" data-focus style="--i:2">
          {L('Nazwę wybrała w 1991 roku grupa studentów poznańskich uczelni. W logo litera Y jest kamertonem, a ostatnie S stoi odwrotnie, jak nuta nie na swoim miejscu.', 'A group of Poznań students chose the name in 1991. In the logo the Y is a tuning fork, and the last S is reversed, like a note out of place.')}
        </p>
      </div>
      <div class="name__pics">
        <figure class="name__pic name__pic--a shutter" data-reveal><Image src={madonna} alt={L('Chór przed ołtarzem', 'The choir before an altar')} widths={[600, 1000]} sizes="(max-width: 860px) 70vw, 26vw" class="cover" /></figure>
        <figure class="name__pic name__pic--b shutter" data-reveal><Image src={nave} alt={L('Bazylika św. Piotra w Rzymie podczas występu chóru', 'St Peter’s Basilica in Rome during a performance')} widths={[800, 1400]} sizes="(max-width: 860px) 90vw, 38vw" class="cover" /></figure>
        <figure class="name__pic name__pic--c shutter" data-reveal><Image src={scores} alt={L('Chórzyści z nutami w dłoniach', 'Singers with scores in hand')} widths={[500, 900]} sizes="(max-width: 860px) 60vw, 20vw" class="cover" /></figure>
      </div>
    </div>
  </section>

  <div id="nastroj"><ResolveIt lang={lang} /></div>

  <section class="albums wrap" aria-labelledby="albums-title">
    <div class="section-head">
      <div>
        <h2 id="albums-title" class="section-title" data-focus>{L('Najnowsze płyty', 'Latest albums')}</h2>
        <p class="lead" data-focus style="--i:1">{L('Do posłuchania na Spotify, do kupienia w Music Island.', 'Stream them on Spotify, buy them at Music Island.')}</p>
      </div>
      <a class="arrow-link" href={routes.shop[lang]} data-focus style="--i:2">{L('Wszystkie płyty', 'All albums')}<Icon name="arrow-up-right" size={18} /></a>
    </div>
    <div class="albums__grid">
      {showcase.map((s, i) => (
        <article class="album panel" data-reveal style={`--i:${i}`}>
          <div class="album__photo inset">
            <Image src={s.bg} alt={s.bgAlt} widths={[700, 1200, 1600]} sizes="(max-width: 860px) 100vw, 46vw" class="cover" />
            <span class="album__badge glass on-media">{s.badge}</span>
          </div>
          <div class="album__row">
            <Image src={s.cover} alt={L(`Okładka płyty ${s.album.title}`, `${s.album.title} album cover`)} width={200} height={200} class="album__cover" />
            <div class="album__info">
              <h3 class="tile-title">{s.album.title}</h3>
              <p class="tile-kicker">{s.variant}</p>
            </div>
            <p class="album__price nums">{s.album.buy?.price}</p>
          </div>
          <div class="album__actions">
            <a class="button button--sm" href={s.album.buy?.url} target="_blank" rel="noopener"><Icon name="shopping-bag-open" size={18} />{L('Kup płytę', 'Buy the CD')}</a>
            {s.album.spotifyAlbum && <a class="button button--sm button--ghost" href={`https://open.spotify.com/album/${s.album.spotifyAlbum}`} target="_blank" rel="noopener"><Icon name="spotify-logo" size={18} />Spotify</a>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="stats wrap" aria-labelledby="stats-title">
    <div class="section-head">
      <h2 id="stats-title" class="section-title" data-focus>{L('W liczbach', 'In numbers')}</h2>
      <a class="arrow-link" href={routes.awards[lang]} data-focus style="--i:1">{L('Wszystkie nagrody', 'All awards')}<Icon name="arrow-up-right" size={18} /></a>
    </div>
    <dl class="stats__grid">
      {stats.map((s, i) => (
        <div class="stat tile" data-reveal style={`--i:${i}`}>
          <span class="chip-icon"><Icon name={s.icon} weight="duotone" size={24} /></span>
          <dd class="stat__n nums">{s.n}</dd>
          <dt class="stat__h">{s.h}</dt>
          <dd class="stat__s">{s.s}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="gigs wrap" aria-labelledby="gigs-title">
    <div class="section-head">
      <div>
        <h2 id="gigs-title" class="section-title" data-focus>{L('Ostatnio na scenie', 'Lately on stage')}</h2>
        <p class="lead" data-focus style="--i:1">{L('Chcesz nas u siebie? Napisz, odpowiemy z repertuarem.', 'Want us at your venue? Write and we will reply with repertoire.')}</p>
      </div>
      <a class="button button--ghost" href={invite} data-focus style="--i:2"><Icon name="envelope-simple" size={18} />{L('Zaproś nas', 'Invite us')}</a>
    </div>
    <ul class="gigs__list panel">
      {concerts.map((c, i) => (
        <li class="gig" data-reveal style={`--i:${i}`}>
          <span class="chip-icon chip-icon--neutral"><Icon name="ticket" weight="duotone" size={22} /></span>
          <span class="gig__what">
            <span class="gig__title">{t(c.title, lang)}</span>
            <span class="meta"><Icon name="map-pin" size={16} />{t(c.place, lang)}</span>
          </span>
          <span class="gig__when nums"><Icon name="calendar-blank" size={16} />{t(c.date, lang)}{c.time && ` · ${c.time}`}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="join wrap" aria-labelledby="join-title">
    <div class="join__panel panel">
      <svg class="join__fork" viewBox="166 -10 121 250" role="img" aria-label={L('Kamerton z logo Dysonansu', 'The tuning fork from the Dysonans logo')} data-reveal>
        <path d="M186.5 -10L186.5 99.5A40 40 0 0 0 266.5 99.5L266.5 -10M226.5 130.5L226.5 240" fill="none" stroke="var(--brand-red)" stroke-width="21" />
      </svg>
      <div class="join__text">
        <h2 id="join-title" class="section-title" data-focus>{L('Zaśpiewaj z nami', 'Sing with us')}</h2>
        <p class="lead" data-focus style="--i:1">{L('Śpiewają u nas studenci i absolwenci poznańskich uczelni. Jeśli czytasz nuty i lubisz napięcie, które się rozwiązuje, napisz.', 'Our singers are students and graduates of Poznań universities. If you read music and like tension that resolves, write to us.')}</p>
        <ul class="join__facts" data-focus style="--i:2">
          <li class="pill"><Icon name="map-pin" size={16} />{L('Próby w Poznaniu', 'Rehearsals in Poznań')}</li>
          <li class="pill"><Icon name="graduation-cap" size={16} />{L('Studenci i absolwenci', 'Students and graduates')}</li>
          <li class="pill"><Icon name="users-three" size={16} />{L('Cztery głosy', 'Four voice parts')}</li>
        </ul>
        <a class="button" href={join} data-focus style="--i:3"><Icon name="paper-plane-tilt" size={18} />{L('Napisz do nas', 'Write to us')}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero: an inset screen of film */
  .hero {
    --r: var(--r-panel);
    position: relative; margin: 10px; min-height: calc(100svh - 20px); border-radius: var(--r); overflow: clip; isolation: isolate;
    display: grid; grid-template-rows: 1fr auto auto; padding: 0 clamp(1.25rem, 4vw, 3.5rem) clamp(1.25rem, 4vw, 3rem); background: #000;
    box-shadow: var(--shadow-lg);
  }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__media :global(video) { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.45) contrast(1.08) saturate(0.85); }
  .hero__title { align-self: end; margin-bottom: clamp(2rem, 6vh, 4rem); color: #F5F5F4; }
  .hero__title :global(.logo) { width: min(100%, 1400px); }
  .hero__foot { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1.5rem 2rem; }
  .hero__line { font-size: var(--step-lead); line-height: 1.35; max-width: 24ch; font-weight: 500; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .hero__ghost { background: var(--glass); color: var(--ink); }
  .hero__credit {
    position: absolute; top: clamp(5.5rem, 12vh, 7rem); right: clamp(1.25rem, 4vw, 3.5rem);
    display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.5rem 0.9rem; border-radius: var(--r-pill);
    font-size: var(--step-small); font-weight: 500;
  }
  @media (max-width: 700px) { .hero__credit { display: none; } }

  .rooms { padding-block: var(--section) calc(var(--section) / 2); }

  /* The name */
  .name { padding-block: calc(var(--section) / 2); }
  .name__grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .name__pin { position: sticky; top: 0; min-height: 100svh; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 1.5rem; }
  .name__pill { color: var(--accent-text); }
  .name__note { max-width: 42ch; }
  .name__pics { display: grid; gap: 30svh; padding-block: 25svh; }
