---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { albums, contact } from '../data/site';
import { t, type Lang } from '../i18n';
import type { ImageMetadata } from 'astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const pl = lang === 'pl';
const L = (p: string, e: string) => (pl ? p : e);

const covers = import.meta.glob<{ default: ImageMetadata }>('../assets/covers/*.jpg', { eager: true });
const cover = (id: string) => covers[`../assets/covers/${id}.jpg`].default;

const order = (title: string, price?: string) => {
  const subject = L(`Zamówienie płyty: ${title}`, `CD order: ${title}`);
  const body = L(
    `Dzień dobry,\n\nchcę zamówić płytę „${title}”${price ? ` (${price})` : ''}.\nLiczba egzemplarzy: 1\nImię i nazwisko:\nAdres do wysyłki:\nTelefon:\n\nDziękuję!`,
    `Hello,\n\nI would like to order the CD “${title}”${price ? ` (${price})` : ''}.\nCopies: 1\nName:\nShipping address:\nPhone:\n\nThank you!`,
  );
  return `mailto:${contact.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
};

const how = [
  { icon: 'shopping-bag-open', h: 'Music Island', s: L('Płatność online i wysyłka z Poznania.', 'Pay online, shipped from Poznań.') },
  { icon: 'envelope-simple', h: L('Mailem', 'By email'), s: L('Przycisk otworzy gotową wiadomość z zamówieniem.', 'The button opens a ready-made order email.') },
  { icon: 'spotify-logo', h: L('Najpierw posłuchaj', 'Listen first'), s: L('Większość płyt jest też na Spotify.', 'Most albums are on Spotify too.') },
];
---

<Base
  lang={lang}
  page="shop"
  title={L('Sklep', 'Shop')}
  description={L('Płyty Chóru Kameralnego Dysonans: Salve Regina, Christmas Bells, Ã che Ángele. Kup w Music Island albo zamów mailem.', 'Dysonans Chamber Choir CDs: Salve Regina, Christmas Bells, Ã che Ángele. Buy at Music Island or order by email.')}
>
  <header class="page-head wrap">
    <h1 data-focus>{L('Sklep', 'Shop')}</h1>
    <p class="lead" data-focus style="--i:1">{L('Płyty sprzedaje ', 'Our CDs are sold by ')}<a class="link" href={contact.musicIsland} target="_blank" rel="noopener">Music Island</a>{L('. Możesz też zamówić je mailem, bezpośrednio u nas. Bez koszyka i zakładania konta.', '. You can also order them from us by email. No basket, no account.')}</p>
  </header>

  <section class="how wrap" aria-label={L('Jak kupić', 'How to buy')}>
    {how.map((h, i) => (
      <div class="how__item tile tile--flat" data-reveal style={`--i:${i}`}>
        <span class="chip-icon chip-icon--neutral"><Icon name={h.icon} weight="duotone" size={22} /></span>
        <span><strong>{h.h}</strong><span class="how__s">{h.s}</span></span>
      </div>
    ))}
  </section>

  <section class="shop wrap" aria-labelledby="shop-title">
    <h2 id="shop-title" class="sr-only">{L('Płyty', 'CDs')}</h2>
    <ul class="shop__grid">
      {albums.map((a, i) => (
        <li class="product tile" id={a.id} data-reveal style={`--i:${i % 2}`}>
          <Image src={cover(a.id)} alt={L(`Okładka płyty ${a.title}`, `${a.title} album cover`)} widths={[220, 440]} sizes="11rem" class="product__cover inset" />
          <div class="product__body">
            <p class="tile-kicker nums">CD · {[a.year, a.label].filter(Boolean).join(' · ')}</p>
            <h3 class="tile-title">{a.title}</h3>
            <p class="product__note">{t(a.note, lang)}</p>
          </div>
          <div class="product__foot">
            <p class="product__price nums">{a.buy ? a.buy.price : L('Zapytaj', 'Ask us')}</p>
            <div class="product__actions">
              {a.buy && <a class="button button--sm" href={a.buy.url} target="_blank" rel="noopener"><Icon name="shopping-bag-open" size={18} />{L('Kup', 'Buy')}</a>}
              <a class="button button--sm button--ghost" href={order(a.title, a.buy?.price)}><Icon name="envelope-simple" size={18} />{a.buy ? L('Zamów mailem', 'Email order') : L('Napisz', 'Write')}</a>
              {a.spotifyAlbum && <a class="icon-button" href={`https://open.spotify.com/album/${a.spotifyAlbum}`} target="_blank" rel="noopener" aria-label={L(`Posłuchaj ${a.title} na Spotify`, `Listen to ${a.title} on Spotify`)}><Icon name="spotify-logo" size={20} /></a>}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .how { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); margin-bottom: var(--gutter); }
  .how__item { --p: 1rem; display: flex; gap: 0.9rem; align-items: center; }
  .how__item strong { display: block; font-weight: 500; }
  .how__s { display: block; color: var(--muted); font-size: var(--step-small); }

  .shop { padding-bottom: var(--section); }
  .shop__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gutter); }
  .product { --p: 14px; display: grid; grid-template-columns: 11rem minmax(0, 1fr); grid-template-rows: 1fr auto; column-gap: 1.25rem; align-items: start; }
  .product__cover { grid-row: 1 / span 2; }
  .product__cover { width: 11rem; height: 11rem; object-fit: cover; box-shadow: var(--shadow-sm); }
  .product__body { display: grid; gap: 0.45rem; padding: 0.35rem 0.5rem 0 0; }
  .product__note { color: var(--muted); font-size: var(--step-small); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .product__foot { grid-column: 2; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.75rem 0.25rem 0.25rem 0; }
  .product__price { font-size: var(--step-lead); font-weight: 500; }
  .product__actions { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  @media (max-width: 1100px) { .shop__grid { grid-template-columns: 1fr; } }
  @media (max-width: 860px) { .how { grid-template-columns: 1fr; } }
  @media (max-width: 520px) {
    .product { grid-template-columns: 6.5rem minmax(0, 1fr); gap: 1rem; }
    .product__cover { width: 6.5rem; height: 6.5rem; }
    .product__cover { grid-row: 1; }
    .product__foot { grid-column: 1 / -1; padding: 1rem 0.25rem 0.25rem; }
  }
</style>
